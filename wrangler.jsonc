{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flighty-mcp",
  "account_id": "d07b110f410fe3016dae9409da71b2ba",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Public MCP URL is https://flighty-mcp.odell.io/mcp. OAuth tokens are bound to
  // the request origin, so this is the hostname registered with Access.
  "workers_dev": false,
  "minify": true,
  "routes": [
    { "pattern": "flighty-mcp.odell.io", "custom_domain": true }
  ],
  "vars": {
    "FLIGHTY_ALLOW_WRITES": "true",
    "FLIGHTY_ALLOW_ACCOUNT_DELETION": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flighty-mcp",
      "database_id": "42bfcf77-8ba9-4c1a-b06b-fe443cf62cd1",
      "migrations_dir": "migrations"
    }
  ],
  // Namespace title: flighty-mcp-oauth
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "014b53be447d41b293d9b4bf74af63bb"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "flighty-mcp-sync" }
    ],
    "consumers": [
      {
        "queue": "flighty-mcp-sync",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "visibility_timeout_ms": 120000
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "secrets": {
    "required": [
      "FLIGHTY_TOKEN",
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY",
      "ACCESS_ALLOWED_EMAIL"
    ]
  }
  // Optional secrets: FLIGHTY_BUILD_TOKEN
  // Optional vars: FLIGHTY_LOCALE, FLIGHTY_USER_AGENT, FLIGHTY_DEVICE_ID, FLIGHTY_TIMEOUT, FLIGHTY_CACHE_TTL, FLIGHTY_MAX_PAGES, FLIGHTY_SYNC_PAGES_PER_RUN
  // Queue flighty-mcp-sync (199a638623e4490fabd771415783aa95) is bound by name.
  // Deploy deletes the unused MCP_TOKEN secret. See .github/workflows/deploy.yml.
}
